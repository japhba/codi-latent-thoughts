+    def _save(self, output_dir=None, state_dict=None):
+        # CODI is a plain nn.Module wrapping a FROZEN base + LoRA adapter + projection. The default
+        # save serializes the whole module (~56GB for gemma-27b). We only need: the trainable params
+        # (LoRA + prj) plus embed_tokens/lm_head (frozen, but carry the non-deterministic resized
+        # <|bocot|>/<|eocot|> rows from resize_token_embeddings(mean_resizing=False), so they MUST be
+        # saved or reload re-randomizes the latent delimiters). The frozen base is reconstructed from
+        # the HF model on load (CODI.from_pretrained uses strict=False). ~4GB vs 56GB.
+        output_dir = output_dir if output_dir is not None else self.args.output_dir
+        os.makedirs(output_dir, exist_ok=True)
+        if state_dict is None:
+            state_dict = self.model.state_dict()
+        keep = {n for n, p in self.model.named_parameters() if p.requires_grad}
+        filtered = {
+            k: v
+            for k, v in state_dict.items()
+            if k in keep or "embed_tokens" in k or "lm_head" in k
+        }
+        torch.save(filtered, os.path.join(output_dir, "pytorch_model.bin"))
+        if self.tokenizer is not None:
+            self.tokenizer.save_pretrained(output_dir)
+        torch.save(self.args, os.path.join(output_dir, "training_args.bin"))
+        if is_main_process():
+            print(
+                f"[save] adapter-only checkpoint ({len(filtered)} tensors) -> {output_dir}",
+                flush=True,
+            )
