+def _latent_node_targets(steps, tokenizer, num_latent):
+    """JB: gold single-token node ids for latent-supervision. latent i should encode node[i+1] (the
+    chase result after i+1 hops). Returns a num_latent-long list, -100 where no target / not single-token.
+    Handles prose CoT ('Start: X.', 'Step k: A -> B.') and bare-node CoT (['c','i','i'])."""
+    if steps and isinstance(steps[0], str) and steps[0].startswith("Start"):
+        nodes = [steps[0].split("Start:", 1)[1].strip().rstrip(".")]
+        for s in steps[1:]:
+            nodes.append(s.split("->", 1)[1].strip().rstrip("."))
+    else:
+        nodes = [str(s).strip() for s in steps]
+    out = []
+    for i in range(num_latent):
+        gi = i + 1
+        ids = tokenizer(" " + nodes[gi], add_special_tokens=False).input_ids if gi < len(nodes) else []
+        out.append(ids[0] if len(ids) == 1 else -100)
+    return out
+
